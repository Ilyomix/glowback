<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": second signing request of a release (.github/workflows/release.yml).
     GlowbackSetup.exe, built from the apps signed by the first request. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="GlowbackSetup.exe" product-name="Glowback" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
